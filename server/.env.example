# Copy to server/.env and adjust.
PORT=4000
# Must point at a replica set (transactions + change streams). The docker-compose Mongo works:
MONGO_URI=mongodb://localhost:27017/newtonite?directConnection=true
JWT_SECRET=change-me
JWT_TTL=12h
# Run the background job worker inside the API process (set false and use `npm run worker` to split).
RUN_WORKER=true
WORKER_POLL_MS=1000
STALE_AFTER_DAYS=3
# Show demo accounts on the login page.
DEMO_LOGIN=true
